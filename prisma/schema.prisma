model Setting {
  key       String   @id
  label     String
  value     String   @default("")
  group     String   @default("geral")
  type      String   @default("text")
  hint      String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Page {
  slug           String   @id
  title          String
  eyebrow        String?
  lead           String?
  body           String   @default("")
  videoId        String?
  coverId        String?
  cover          Media?   @relation("PageCover", fields: [coverId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  editable       Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  /// SHA-256 do `body` na última vez que uma migração de conteúdo escreveu
  /// esta página. É o que distingue "ninguém tocou desde que gravamos" de
  /// "alguém editou no painel": se o hash do corpo atual não bate com este
  /// valor, houve edição humana e nenhuma migração pode sobrescrevê-la.
  /// Nulo em página que jamais passou por migração — inclusive nas herdadas
  /// do site em PHP, que é justamente o caso que a primeira execução trata.
  systemHash String?

  gallery   PageImage[]
  revisions PageRevision[]
}

/// Versão anterior do conteúdo de uma página, guardada antes de sobrescrever.
///
/// O `AuditLog` registra que alguém editou e resume o que mudou, mas guarda
/// texto, não o corpo inteiro — não dá para restaurar a partir dele. Migração
/// de conteúdo sem cópia recuperável é perda de dado com etapa extra, então o
/// corpo completo vem para cá antes de qualquer escrita automática.
model PageRevision {
  id       String @id @default(cuid())
  pageSlug String
  page     Page   @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)

  title          String
  eyebrow        String?
  lead           String?
  body           String
  seoTitle       String?
  seoDescription String?

  /// SHA-256 do `body` desta revisão. Serve para reconhecer o conteúdo sem
  /// comparar strings longas e para tornar a migração idempotente.
  bodyHash String

  /// De onde veio a escrita que substituiu esta versão: `migracao:<nome>`
  /// quando foi um script, `manual` quando foi o painel.
  origin String

  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([pageSlug, createdAt])
}

model PageImage {
  id       String  @id @default(cuid())
  pageSlug String
  page     Page    @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  mediaId  String
  media    Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption  String?
  order    Int     @default(0)

  @@index([pageSlug, order])
}

/// Seções da home, editáveis e ordenáveis — no lugar de um HTML gigante.
model HomeSection {
  id        String   @id @default(cuid())
  kind      String // hero | confianca | categorias | destaques | seminovos | assistencia | como_funciona | minha_jb | planos | sobre | faq | cta
  title     String   @default("")
  subtitle  String   @default("")
  body      String   @default("")
  ctaLabel  String   @default("")
  ctaHref   String   @default("")
  mediaId   String?
  media     Media?   @relation("HomeSectionMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  config    Json     @default("{}")
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Slide {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  href      String?
  imageId   String?
  image     Media?    @relation("SlideImage", fields: [imageId], references: [id], onDelete: SetNull)
  order     Int       @default(0)
  published Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt
}

/// Formulário de contato do site. Preservado do site anterior.
model Lead {
  id        String   @id @default(cuid())
  nome      String
  endereco  String   @default("")
  bairro    String   @default("")
  cidade    String   @default("")
  estado    String   @default("")
  cep       String   @default("")
  telefone  String   @default("")
  email     String
  obs       String   @default("")
  news      Boolean  @default(false)
  status    String   @default("novo")
  notas     String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mime      String
  size      Int
  width     Int?
  height    Int?
  alt       String   @default("")
  folder    String   @default("geral")
  createdAt DateTime @default(now())

  pageCovers     Page[]                @relation("PageCover")
  pageImages     PageImage[]
  slides         Slide[]               @relation("SlideImage")
  homeSections   HomeSection[]         @relation("HomeSectionMedia")
  brandLogos     Brand[]               @relation("BrandLogo")
  categoryImages Category[]            @relation("CategoryImage")
  productMedia   ProductMedia[]
  unitMedia      InventoryUnitMedia[]
  equipmentMedia EquipmentMedia[]
  requestMedia   ServiceRequestMedia[]
  workOrderMedia WorkOrderMedia[]

  @@index([folder, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String   @default("")
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Sequência dos códigos legíveis (JB-, OS-, ORC-, AT-). Incremento atômico.
model DocumentSequence {
  prefix    String   @id
  current   Int      @default(0)
  updatedAt DateTime @updatedAt
}

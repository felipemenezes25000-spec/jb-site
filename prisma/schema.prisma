// CMS da JB Soluções Odontológicas — substitui o MARS v5.3.1
// Postgres no desenvolvimento e na produção: o banco local (Docker, porta 5433)
// é o mesmo motor do Postgres da Vercel, para não haver surpresa no deploy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Usuários do painel. Substitui `usuarios` (que guardava senha em texto plano).
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("editor") // "admin" | "editor"
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs AuditLog[]
}

/// Configurações do site (telefone, endereço, redes). Substitui `configuracoes`.
model Setting {
  key       String   @id
  label     String
  value     String   @default("")
  group     String   @default("geral") // geral | contato | social | seo
  type      String   @default("text") // text | textarea | url | email | tel | html
  hint      String?
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Páginas de conteúdo (Empresa, Estrutura...). Substitui `institucional` + `seo`.
model Page {
  slug           String   @id
  title          String
  eyebrow        String? // rótulo curto acima do título
  lead           String? // parágrafo de abertura
  body           String   @default("") // HTML do editor
  videoId        String? // id do vídeo no YouTube, como no campo `video` do MARS
  coverId        String?
  cover          Media?   @relation("PageCover", fields: [coverId], references: [id], onDelete: SetNull)
  seoTitle       String?
  seoDescription String?
  editable       Boolean  @default(true) // false = rota fixa, só edita conteúdo
  updatedAt      DateTime @updatedAt

  gallery PageImage[]
}

model PageImage {
  id       String @id @default(cuid())
  pageSlug String
  page     Page   @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  mediaId  String
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption  String?
  order    Int    @default(0)

  @@index([pageSlug, order])
}

/// Categorias de solução (Biosegurança, Profilaxia...). Substitui `mp5600_servicos`.
model ServiceCategory {
  slug        String   @id
  name        String
  description String   @default("") // HTML da lista de equipamentos, como no MARS
  imageId     String?
  image       Media?   @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Chamadas da home. Substitui `home`.
model Highlight {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  body      String?
  href      String?
  target    String   @default("_self")
  imageId   String?
  image     Media?   @relation("HighlightImage", fields: [imageId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Peças do hero. Substitui `area_nobre` (slides), com janela de exibição.
model Slide {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  href      String?
  imageId   String?
  image     Media?    @relation("SlideImage", fields: [imageId], references: [id], onDelete: SetNull)
  order     Int       @default(0)
  published Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt
}

/// Cadastros recebidos pelo formulário de contato. Substitui `cadastros`.
model Lead {
  id        String   @id @default(cuid())
  nome      String
  endereco  String   @default("")
  bairro    String   @default("")
  cidade    String   @default("")
  estado    String   @default("")
  cep       String   @default("")
  telefone  String   @default("")
  email     String
  obs       String   @default("")
  news      Boolean  @default(false) // quis receber informações da empresa
  status    String   @default("novo") // novo | em_andamento | concluido | arquivado
  notas     String   @default("")
  ip        String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

/// Biblioteca de mídia. Substitui a pasta solta `images/online`.
model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mime      String
  size      Int
  width     Int?
  height    Int?
  alt       String   @default("")
  folder    String   @default("geral")
  createdAt DateTime @default(now())

  pageCovers     Page[]            @relation("PageCover")
  pageImages     PageImage[]
  categoryImages ServiceCategory[] @relation("CategoryImage")
  highlights     Highlight[]       @relation("HighlightImage")
  slides         Slide[]           @relation("SlideImage")
}

/// Trilha de auditoria do painel. Substitui `log`.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // create | update | delete | login | logout
  entity    String
  entityId  String   @default("")
  summary   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

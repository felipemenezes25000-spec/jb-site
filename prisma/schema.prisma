// ============================================================================
// JB Soluções Odontológicas — plataforma
//
// Loja + assistência técnica + prontuário de equipamentos + Área da Clínica + backoffice.
// Vendedor único: a própria JB. Sem sellers, comissão ou split.
//
// Dinheiro sempre em CENTAVOS (Int). Nunca Float.
// Datas em UTC no banco; a exibição converte para America/Sao_Paulo.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================================
// EQUIPE INTERNA
// ============================================================================

enum StaffRole {
  admin
  gestor
  comercial
  tecnico
  editor
}

/// Usuários do backoffice. Nunca representa cliente final.
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(editor)
  active       Boolean   @default(true)
  phone        String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs  AuditLog[]
  technician Technician?

  @@index([role, active])
}

/// Técnico de campo. Estende um usuário interno com dados operacionais.
model Technician {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties String[] @default([])
  active      Boolean  @default(true)
  colorTag    String? // cor na agenda
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments ServiceAppointment[]
  workOrders   WorkOrder[]
  visits       MaintenanceVisit[]
}

// ============================================================================
// CLIENTES
// ============================================================================

enum PersonType {
  fisica
  juridica
}

model Customer {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  passwordHash     String? // nulo em pedido de convidado ainda não convertido
  phone            String     @default("")
  personType       PersonType @default(fisica)
  document         String     @default("") // CPF ou CNPJ, só dígitos
  companyName      String     @default("") // razão social
  tradeName        String     @default("") // nome fantasia
  stateRegistry    String     @default("")
  emailVerifiedAt  DateTime?
  marketingOptInAt DateTime?
  active           Boolean    @default(true)
  lastLoginAt      DateTime?
  notes            String     @default("") // nota interna, nunca exibida ao cliente
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  addresses       CustomerAddress[]
  locations       CustomerLocation[]
  carts           Cart[]
  orders          Order[]
  favorites       Favorite[]
  equipments      Equipment[]
  serviceRequests ServiceRequest[]
  quotes          Quote[]
  documents       Document[]
  notifications   Notification[]
  tickets         SupportTicket[]
  contracts       MaintenanceContract[]
  resetTokens     PasswordResetToken[]
  loginAttempts   LoginAttempt[]

  @@index([document])
  @@index([createdAt])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String   @default("Principal")
  recipient  String   @default("")
  zip        String
  street     String
  number     String
  complement String   @default("")
  district   String
  city       String
  state      String
  reference  String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  locations CustomerLocation[]

  @@index([customerId])
}

/// Clínica/unidade do cliente. Um equipamento vive em uma unidade e sala.
model CustomerLocation {
  id         String           @id @default(cuid())
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  addressId  String?
  address    CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  notes      String           @default("")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  equipments Equipment[]

  @@index([customerId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Tentativas de login, para travar força bruta sem depender de serviço externo.
model LoginAttempt {
  id         String    @id @default(cuid())
  identifier String // e-mail em minúsculas
  ip         String    @default("")
  success    Boolean   @default(false)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
}

// ============================================================================
// CATÁLOGO
// ============================================================================

enum ProductStatus {
  draft
  active
  archived
}

enum ProductCondition {
  novo
  seminovo
  usado
  recondicionado
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  logoId      String?
  logo        Media?   @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([published, order])
}

model Category {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  description    String     @default("")
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  imageId        String?
  image          Media?     @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  icon           String? // nome do ícone Lucide
  order          Int        @default(0)
  published      Boolean    @default(true)
  featured       Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  products        Product[]
  serviceRequests ServiceRequest[]
  equipments      Equipment[]

  @@index([published, order])
  @@index([parentId])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  sku              String           @unique
  name             String
  model            String           @default("")
  shortDescription String           @default("")
  description      String           @default("") // HTML sanitizado
  status           ProductStatus    @default(draft)
  condition        ProductCondition @default(novo)
  featured         Boolean          @default(false)
  publishedAt      DateTime?

  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // preços em centavos
  priceCents          Int     @default(0)
  compareAtCents      Int? // preço anterior, para exibir desconto
  costCents           Int? // custo interno, nunca exposto
  allowDirectPurchase Boolean @default(true)
  allowQuoteRequest   Boolean @default(true)

  // estoque
  trackInventory Boolean @default(true)
  unique         Boolean @default(false) // seminovo/usado: uma única unidade
  stock          Int     @default(0)
  lowStockAlert  Int     @default(1)

  // logística e ficha
  warrantyMonths    Int?
  voltage           String? // 110 | 220 | bivolt
  weightGrams       Int?
  widthMm           Int?
  heightMm          Int?
  depthMm           Int?
  shippingProfileId String?
  shippingProfile   ShippingProfile? @relation(fields: [shippingProfileId], references: [id], onDelete: SetNull)

  // regulatório — todos opcionais, nunca inventar
  anvisaCode       String?
  manufacturer     String?
  regulatoryHolder String?
  regulatoryNote   String?

  seoTitle       String?
  seoDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media       ProductMedia[]
  specs       ProductSpec[]
  documents   ProductDocument[]
  addons      ProductAddon[]
  units       InventoryUnit[]
  movements   InventoryMovement[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  favorites   Favorite[]
  quoteItems  QuoteItem[]
  equipments  Equipment[]
  relatedFrom ProductRelation[]   @relation("RelationSource")
  relatedTo   ProductRelation[]   @relation("RelationTarget")
  faqs        Faq[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([condition, status])
  @@index([featured, status])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  alt       String   @default("")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([productId, mediaId])
  @@index([productId, order])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String  @default("Ficha técnica")
  label     String
  value     String
  order     Int     @default(0)

  @@index([productId, order])
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String
  url       String
  kind      String   @default("manual")
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductRelation {
  id       String  @id @default(cuid())
  sourceId String
  source   Product @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   Product @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  order    Int     @default(0)

  @@unique([sourceId, targetId])
}

/// Serviço que pode ser vendido junto de um produto (instalação, preventiva…).
model ProductAddon {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceCents Int? // sobrepõe o preço padrão do serviço quando definido
  required   Boolean @default(false)
  order      Int     @default(0)

  @@unique([productId, serviceId])
}

// ============================================================================
// ESTOQUE
// ============================================================================

enum UnitStatus {
  disponivel
  reservado
  vendido
  indisponivel
}

/// Unidade física identificável. Obrigatória para seminovo/usado/recondicionado.
model InventoryUnit {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  serialNumber String?
  status       UnitStatus @default(disponivel)

  manufactureYear Int?
  usageHours      Int?
  usageCycles     Int?
  conditionNotes  String @default("")
  inspectionNotes String @default("")
  warrantyMonths  Int?
  acquiredFrom    String @default("")

  orderItemId String?    @unique
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checklist InventoryCheckItem[]
  media     InventoryUnitMedia[]

  @@index([productId, status])
  @@index([serialNumber])
}

/// Item do checklist de revisão do seminovo — o que foi verificado e trocado.
model InventoryCheckItem {
  id     String        @id @default(cuid())
  unitId String
  unit   InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  label  String
  result String        @default("verificado") // verificado | substituido | reparado | nao_aplicavel
  note   String        @default("")
  order  Int           @default(0)

  @@index([unitId, order])
}

model InventoryUnitMedia {
  id      String        @id @default(cuid())
  unitId  String
  unit    InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  mediaId String
  media   Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order   Int           @default(0)

  @@unique([unitId, mediaId])
}

enum StockMovementKind {
  entrada
  saida
  reserva
  liberacao_reserva
  ajuste
  devolucao
}

model InventoryMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      StockMovementKind
  quantity  Int
  reason    String            @default("")
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime          @default(now())

  @@index([productId, createdAt])
}

// ============================================================================
// SERVIÇOS VENDÁVEIS
// ============================================================================

enum ServiceKind {
  instalacao
  visita_tecnica
  manutencao_preventiva
  manutencao_corretiva
  treinamento
  retirada_equipamento
  outro
}

model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  kind        ServiceKind @default(outro)
  description String      @default("")
  priceCents  Int? // nulo = sob orçamento
  published   Boolean     @default(true)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  addons     ProductAddon[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  quoteItems QuoteItem[]

  @@index([published, order])
}

// ============================================================================
// LOGÍSTICA
// ============================================================================

enum ShippingKind {
  retirada
  entrega_local
  transportadora
  sob_orcamento
  gratis
  nao_aplicavel
}

model ShippingProfile {
  id             String       @id @default(cuid())
  name           String
  kind           ShippingKind @default(sob_orcamento)
  description    String       @default("")
  freeAboveCents Int?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  zones    ShippingZone[]
  products Product[]
}

/// Faixa de CEP com preço fixo. Suficiente enquanto não há transportadora real.
model ShippingZone {
  id         String          @id @default(cuid())
  profileId  String
  profile    ShippingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  zipStart   String
  zipEnd     String
  priceCents Int             @default(0)
  etaDays    Int?
  order      Int             @default(0)

  @@index([profileId, order])
}

// ============================================================================
// CARRINHO E CUPOM
// ============================================================================

model Cart {
  id         String    @id @default(cuid())
  token      String    @unique // cookie do visitante
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  couponId   String?
  coupon     Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items CartItem[]

  @@index([customerId])
  @@index([updatedAt])
}

model CartItem {
  id        String     @id @default(cuid())
  cartId    String
  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service?   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// quando o serviço foi adicionado como add-on de um item de produto
  parentId  String?
  parent    CartItem?  @relation("AddonOf", fields: [parentId], references: [id], onDelete: Cascade)
  addons    CartItem[] @relation("AddonOf")
  quantity  Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([cartId])
}

enum CouponKind {
  percentual
  valor_fixo
}

model Coupon {
  id                 String     @id @default(cuid())
  code               String     @unique
  kind               CouponKind @default(percentual)
  value              Int // percentual (0-100) ou centavos
  minSubtotalCents   Int        @default(0)
  maxUses            Int?
  maxUsesPerCustomer Int?
  usedCount          Int        @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  active             Boolean    @default(true)
  categoryId         String?
  productId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([active, endsAt])
}

// ============================================================================
// PEDIDOS
// ============================================================================

enum OrderStatus {
  aguardando_pagamento
  pagamento_em_analise
  pago
  separacao
  revisao_tecnica
  aguardando_frete
  pronto_retirada
  enviado
  instalacao_agendada
  entregue
  concluido
  cancelado
  reembolsado
}

model Order {
  id     String      @id @default(cuid())
  number String      @unique // JB-001054
  status OrderStatus @default(aguardando_pagamento)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // snapshot do comprador no momento da compra
  buyerName     String
  buyerEmail    String
  buyerPhone    String     @default("")
  buyerDocument String     @default("")
  personType    PersonType @default(fisica)
  companyName   String     @default("")

  // snapshot do endereço
  shippingKind   ShippingKind @default(retirada)
  shippingLabel  String       @default("")
  shipZip        String       @default("")
  shipStreet     String       @default("")
  shipNumber     String       @default("")
  shipComplement String       @default("")
  shipDistrict   String       @default("")
  shipCity       String       @default("")
  shipState      String       @default("")
  shipReference  String       @default("")

  subtotalCents Int @default(0)
  discountCents Int @default(0)
  shippingCents Int @default(0)
  totalCents    Int @default(0)

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String  @default("")

  customerNote String @default("")
  internalNote String @default("")

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  closedAt    DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  events       OrderStatusEvent[]
  payments     Payment[]
  movements    InventoryMovement[]
  equipments   Equipment[]
  documents    Document[]
  quote        Quote?
  installTasks InstallationTask[]

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([buyerEmail])
}

enum OrderItemKind {
  produto
  servico
}

model OrderItem {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    OrderItemKind @default(produto)

  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  serviceId String?
  service   Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    OrderItem?  @relation("OrderAddonOf", fields: [parentId], references: [id], onDelete: Cascade)
  addons    OrderItem[] @relation("OrderAddonOf")

  // snapshot — o pedido antigo nunca depende do produto atual
  name           String
  sku            String            @default("")
  brandName      String            @default("")
  modelName      String            @default("")
  condition      ProductCondition?
  imageUrl       String            @default("")
  unitPriceCents Int
  quantity       Int               @default(1)
  totalCents     Int

  unit InventoryUnit?

  @@index([orderId])
}

model OrderStatusEvent {
  id                String      @id @default(cuid())
  orderId           String
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status            OrderStatus
  note              String      @default("")
  visibleToCustomer Boolean     @default(true)
  userId            String?
  createdAt         DateTime    @default(now())

  @@index([orderId, createdAt])
}

/// Tarefa operacional gerada quando o cliente compra instalação.
model InstallationTask {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String    @default("pendente") // pendente | agendada | concluida | cancelada
  scheduledAt DateTime?
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  appointment ServiceAppointment?

  @@index([status, scheduledAt])
}

// ============================================================================
// PAGAMENTOS
// ============================================================================

enum PaymentMethod {
  pix
  cartao
  boleto
  manual
}

enum PaymentStatus {
  criado
  pendente
  em_analise
  aprovado
  recusado
  expirado
  cancelado
  estornado
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider String        @default("mock")
  method   PaymentMethod
  status   PaymentStatus @default(criado)

  amountCents  Int
  installments Int @default(1)

  externalId   String?   @unique
  pixQrCode    String?
  pixCopyPaste String?
  expiresAt    DateTime?

  /// só os últimos 4 dígitos e a bandeira. Nunca o número completo nem CVV.
  cardBrand String?
  cardLast4 String?

  approvedAt DateTime?
  failReason String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PaymentEvent[]

  @@index([orderId, createdAt])
  @@index([status])
}

/// Cada notificação recebida do provider. `eventKey` garante idempotência.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventKey  String   @unique
  kind      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

// ============================================================================
// EQUIPAMENTOS DO CLIENTE
// ============================================================================

enum EquipmentStatus {
  operacional
  em_manutencao
  aguardando_peca
  inoperante
  desativado
}

enum EquipmentOrigin {
  compra_jb
  cadastro_cliente
  cadastro_tecnico
  atendimento
}

model Equipment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name         String
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandName    String    @default("")
  modelName    String    @default("")
  serialNumber String    @default("")
  voltage      String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  locationId String?
  location   CustomerLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  room       String            @default("")

  origin                  EquipmentOrigin   @default(cadastro_cliente)
  status                  EquipmentStatus   @default(operacional)
  condition               ProductCondition?
  manufacturedAt          DateTime?
  purchasedAt             DateTime?
  installedAt             DateTime?
  warrantyUntil           DateTime?
  lastMaintenanceAt       DateTime?
  nextMaintenanceAt       DateTime?
  maintenanceIntervalDays Int?

  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media           EquipmentMedia[]
  events          EquipmentEvent[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  visits          MaintenanceVisit[]
  documents       Document[]
  contractItems   MaintenanceContractItem[]

  @@index([customerId, status])
  @@index([nextMaintenanceAt])
  @@index([serialNumber])
}

model EquipmentMedia {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  mediaId     String

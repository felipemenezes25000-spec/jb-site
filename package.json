{
  "name": "jb-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "db:demo": "tsx prisma/seed-demo.ts",
    "db:demo:limpar": "tsx prisma/seed-demo-limpar.ts",
    "typecheck": "tsc --noEmit",
    "db:demo:operacao": "tsx prisma/seed-demo-operacao.ts",
    "tour": "node scripts/tour.mjs",
    "test": "pnpm test:unit && pnpm e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:relatorio": "playwright show-report tests/.relatorio",
    "prova:atomicidade": "tsx --conditions=react-server scripts/prova-atomicidade.ts",
    "responsivo": "node scripts/responsivo.mjs",
    "a11y": "node scripts/acessibilidade.mjs",
    "conteudo:prever": "tsx scripts/migrar-conteudo-institucional.ts",
    "conteudo:migrar": "tsx scripts/migrar-conteudo-institucional.ts --aplicar"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

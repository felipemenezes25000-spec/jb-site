# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local
.env

# arquivos privados servidos por rota autenticada (@/lib/upload, storage local)
/.arquivos/

/public/uploads/*
!/public/uploads/.gitkeep
prisma/*.db
prisma/*.db-journal

.shots/

# o exemplo precisa ir para o repositório
!.env.example

.vercel
.env*.local

# ajudante local para rodar comandos contra o banco de produção
_prod.sh

# nunca versionar nem manter: aponta para o banco de produção
.env.local
.env.preview

# Scripts de investigação — medição pontual, não fazem parte da suíte.
# Nascem com "_" de propósito: são descartáveis e não devem entrar no repo.
scripts/_*

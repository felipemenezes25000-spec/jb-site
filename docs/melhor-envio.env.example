# Copie os valores aplicáveis para o ambiente da aplicação/Vercel.
# Nunca commite tokens reais.

SHIPPING_PROVIDER="melhor_envio"
MELHOR_ENVIO_ENV="sandbox" # sandbox | production
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_USER_AGENT="JB Solucoes Odontologicas (tecnologia@seudominio.com.br)"

# Opcional: restringe IDs de serviços ofertados pela conta.
MELHOR_ENVIO_SERVICES=""

# 0 = venda comercial com NF-e; 1 = declaração/conteúdo quando legalmente aplicável.
MELHOR_ENVIO_NON_COMMERCIAL="0"

# Remetente.
MELHOR_ENVIO_FROM_NAME="JB Soluções Odontológicas"
MELHOR_ENVIO_FROM_EMAIL=""
MELHOR_ENVIO_FROM_PHONE=""
MELHOR_ENVIO_FROM_DOCUMENT=""
MELHOR_ENVIO_FROM_STATE_REGISTER=""
MELHOR_ENVIO_FROM_ECONOMIC_ACTIVITY_CODE=""
MELHOR_ENVIO_FROM_ADDRESS=""
MELHOR_ENVIO_FROM_NUMBER=""
MELHOR_ENVIO_FROM_COMPLEMENT=""
MELHOR_ENVIO_FROM_DISTRICT=""
MELHOR_ENVIO_FROM_CITY="São Paulo"
MELHOR_ENVIO_FROM_STATE="SP"
MELHOR_ENVIO_FROM_POSTAL_CODE=""

# Token gerado diretamente no painel do Melhor Envio:
# LATAM Cargo, Azul Cargo e Buslog podem exigir agência de postagem.
# Mapeie companyId:agencyId. Aceita CSV ou JSON.
# Ex.: MELHOR_ENVIO_AGENCY_BY_COMPANY="6:123,9:456"
# Ex.: MELHOR_ENVIO_AGENCY_BY_COMPANY='{"6":123,"9":456}'
MELHOR_ENVIO_AGENCY_BY_COMPANY=""

# IDs de transportadoras que, na sua conta, não aceitam volumes agrupados.
# Correios (serviços 1,2,17) e serviço 27 já são tratados automaticamente;
# respostas 422 em cotação multivolume também acionam fallback pacote-a-pacote.
MELHOR_ENVIO_SINGLE_VOLUME_COMPANY_IDS=""

# Por padrão company 9 (Azul Cargo no catálogo atual) é removida de envios
# comerciais, porque este projeto envia chave NF-e, não xml_content.
# Só altere quando o fluxo comercial da conta suportar o requisito atual da API.
MELHOR_ENVIO_COMMERCIAL_DISABLED_COMPANY_IDS="9"

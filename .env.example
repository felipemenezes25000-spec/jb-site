# ------------------------------------------------------------------
# Desenvolvimento (Postgres local via docker compose up -d)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://jb:jb@localhost:5433/jb?schema=public"
AUTH_SECRET="gere-com-o-comando-do-README"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Vercel (produção) — defina em Settings › Environment Variables
# ------------------------------------------------------------------
# DATABASE_URL          vem pronta ao criar o Postgres em Storage
# AUTH_SECRET           gere uma nova, diferente da de desenvolvimento
# NEXT_PUBLIC_SITE_URL  https://www.jbsolucoesodontologicas.com.br
# BLOB_READ_WRITE_TOKEN a Vercel injeta sozinha ao criar o Blob Store
